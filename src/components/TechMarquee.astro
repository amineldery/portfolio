---
import { iconFor, monogramFor } from "../lib/icons";

interface Props {
  items: string[];
}

const { items } = Astro.props;
const half = Math.ceil(items.length / 2);
const rows = [items.slice(0, half), items.slice(half)];
---

<div class="marquee relative my-16 py-6 overflow-hidden border-y border-border bg-surface/40 space-y-5" aria-hidden="true">
  <div class="pointer-events-none absolute inset-y-0 left-0 w-28 bg-gradient-to-r from-bg to-transparent z-10"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-28 bg-gradient-to-l from-bg to-transparent z-10"></div>

  {rows.map((row, r) => (
    <div class={`marquee-track flex items-center gap-10 w-max ${r === 1 ? "reverse" : ""}`}>
      {[...row, ...row, ...row, ...row].map((item) => {
        const icon = iconFor(item);
        return (
          <span class="flex items-center gap-2.5 text-neutral-400 font-mono text-sm whitespace-nowrap">
            {icon ? (
              <img src={icon} alt="" class="w-6 h-6 object-contain" loading="lazy" />
            ) : (
              <span class="grid place-items-center w-6 h-6 rounded bg-[var(--accent-soft)] text-accent text-[10px] font-bold">{monogramFor(item)}</span>
            )}
            {item}
          </span>
        );
      })}
    </div>
  ))}
</div>
