---
import { iconFor } from "../lib/icons";

interface Props {
  items: string[];
}

const { items } = Astro.props;
const track = [...items, ...items];
---

<div class="relative py-10 overflow-hidden border-y border-border bg-surface/40">
  <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-bg to-transparent z-10"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-bg to-transparent z-10"></div>

  <div class="marquee-track flex items-center gap-12 w-max">
    {track.map((item) => {
      const icon = iconFor(item);
      return (
        <span class="flex items-center gap-2 text-neutral-400 font-mono text-sm whitespace-nowrap">
          {icon && <img src={icon} alt="" class="w-6 h-6 opacity-80" loading="lazy" />}
          {item}
        </span>
      );
    })}
  </div>
</div>
