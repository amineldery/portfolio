---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<canvas class={`circuit-canvas absolute inset-0 w-full h-full ${className}`} aria-hidden="true"></canvas>

<script>
  const canvases = document.querySelectorAll<HTMLCanvasElement>(".circuit-canvas");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  canvases.forEach((canvas) => {
    if (reduceMotion) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    let width = 0;
    let height = 0;
    let particles: { x: number; y: number; vx: number; vy: number }[] = [];
    const LINK_DIST = 130;
    let rgb = "52, 211, 153";
    let running = true;

    function readAccent() {
      const probe = document.createElement("span");
      probe.style.color = "var(--color-accent)";
      document.body.appendChild(probe);
      const m = getComputedStyle(probe).color.match(/[\d.]+/g);
      probe.remove();
      if (m) rgb = `${m[0]}, ${m[1]}, ${m[2]}`;
    }
    readAccent();
    window.addEventListener("accentchange", readAccent);

    // stop drawing when the hero is off screen
    new IntersectionObserver(([e]) => {
      const was = running;
      running = e.isIntersecting;
      if (running && !was) requestAnimationFrame(step);
    }).observe(canvas);

    function resize() {
      width = canvas.width = parent!.clientWidth;
      height = canvas.height = parent!.clientHeight;
      const count = Math.min(60, Math.floor((width * height) / 22000));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
      }));
    }

    function step() {
      if (!running) return;
      ctx!.clearRect(0, 0, width, height);

      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x <= 0 || p.x >= width) p.vx *= -1;
        if (p.y <= 0 || p.y >= height) p.vy *= -1;
      }

      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dist = Math.hypot(a.x - b.x, a.y - b.y);
          if (dist < LINK_DIST) {
            ctx!.strokeStyle = `rgba(${rgb}, ${0.16 * (1 - dist / LINK_DIST)})`;
            ctx!.lineWidth = 1;
            ctx!.beginPath();
            ctx!.moveTo(a.x, a.y);
            ctx!.lineTo(b.x, b.y);
            ctx!.stroke();
          }
        }
        ctx!.fillStyle = `rgba(${rgb}, 0.7)`;
        ctx!.beginPath();
        ctx!.arc(a.x, a.y, 1.4, 0, Math.PI * 2);
        ctx!.fill();
      }

      requestAnimationFrame(step);
    }

    const ro = new ResizeObserver(resize);
    ro.observe(parent);
    resize();
    requestAnimationFrame(step);
  });
</script>
