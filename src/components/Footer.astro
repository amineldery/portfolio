---
interface Props {
  email: string;
  linkedin: string;
}

const { email, linkedin } = Astro.props;
---

<footer class="px-6 md:px-16 max-w-5xl mx-auto py-16 border-t border-border">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <p class="font-mono text-xs text-neutral-500">
      © {new Date().getFullYear()} Amin Eldery
    </p>
    <div class="flex gap-4 font-mono text-sm">
      <a href={`mailto:${email}`} class="text-neutral-400 hover:text-accent transition-colors">Email</a>
      <a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-accent transition-colors">LinkedIn</a>
      <a href="/Amin_Eldery_Resume.pdf" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-accent transition-colors">Resume</a>
    </div>
  </div>
</footer>
