---
import { iconFor, monogramFor } from "../lib/icons";
import { ui } from "../lib/ui-icons";

interface Props {
  skills: Record<string, string[]>;
}

const { skills } = Astro.props;
const allSkills = Object.values(skills).flat();

// seeded random so the cloud layout is the same on every build
let seed = 4805;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

const cols = 6;
const rows = Math.ceil(allSkills.length / cols);
const cloud = allSkills.map((skill, i) => {
  const cellW = 100 / cols, cellH = 100 / rows;
  const left = ((i % cols) + 0.5) * cellW + (rand() - 0.5) * cellW * 0.55;
  const top = (Math.floor(i / cols) + 0.5) * cellH + (rand() - 0.5) * cellH * 0.55;
  const style = `left:${left}%; top:${top}%; --fx:${(6 + rand() * 10).toFixed(1)}px; --fy:${(6 + rand() * 10).toFixed(1)}px; --fr:${(3 + rand() * 6).toFixed(1)}deg; --fdur:${(4 + rand() * 4).toFixed(1)}s; --fdelay:${(rand() * 4).toFixed(1)}s;`;
  return { skill, icon: iconFor(skill), monogram: monogramFor(skill), style };
});
---

<section id="skills" class="px-6 md:px-16 max-w-5xl mx-auto py-20">
  <p class="font-mono text-accent text-sm mb-2">04 · $ ls -la /tech_stack</p>
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10">
    <h2 class="reveal text-3xl md:text-4xl font-bold text-white" data-scramble>Tech Stack</h2>
    <div class="reveal inline-flex self-start p-1 rounded-lg border border-border bg-surface/70 font-mono text-xs" role="tablist" aria-label="Skill view">
      <button type="button" class="view-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-accent text-bg" data-view="grid" role="tab" aria-selected="true">
        <span class="w-3.5 h-3.5" set:html={ui.grid} /> Categories
      </button>
      <button type="button" class="view-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-neutral-400 hover:text-white" data-view="cloud" role="tab" aria-selected="false">
        <span class="w-3.5 h-3.5" set:html={ui.orbit} /> Orbit
      </button>
    </div>
  </div>

  <div class="view-panel grid sm:grid-cols-2 gap-5" data-panel="grid">
    {Object.entries(skills).map(([cat, list], ci) => (
      <div class="reveal glow-border rounded-xl border border-border bg-surface/70 p-6" style={`--delay:${ci * 90}ms`}>
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-white">{cat}</h3>
          <span class="font-mono text-xs text-neutral-500">{list.length.toString().padStart(2, "0")}</span>
        </div>
        <div class="flex flex-wrap gap-2">
          {list.map((skill) => {
            const icon = iconFor(skill);
            return (
              <span class="skill-pill inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border bg-bg/60 text-sm text-neutral-300">
                {icon ? (
                  <img src={icon} alt="" class="w-4 h-4 object-contain" loading="lazy" />
                ) : (
                  <span class="grid place-items-center w-4 h-4 rounded-sm bg-[var(--accent-soft)] text-accent text-[9px] font-bold font-mono">{monogramFor(skill)}</span>
                )}
                {skill}
              </span>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <div class="view-panel relative h-[380px] sm:h-[440px] md:h-[500px] rounded-xl border border-border bg-surface/40 overflow-hidden" data-panel="cloud" hidden>
    {cloud.map((item) => (
      <div class="float-icon group absolute -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-1.5" style={item.style}>
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg border border-border bg-bg/80 backdrop-blur-sm flex items-center justify-center transition-all duration-300 group-hover:border-accent group-hover:shadow-[0_0_20px_-4px_var(--color-accent)] group-hover:scale-110">
          {item.icon ? (
            <img src={item.icon} alt={item.skill} class="w-6 h-6 sm:w-7 sm:h-7 object-contain" loading="lazy" />
          ) : (
            <span class="font-mono text-xs font-bold text-accent">{item.monogram}</span>
          )}
        </div>
        <span class="pointer-events-none text-[10px] sm:text-xs font-mono text-neutral-500 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200">{item.skill}</span>
      </div>
    ))}
  </div>
</section>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".view-btn");
  const panels = document.querySelectorAll<HTMLElement>(".view-panel");
  btns.forEach((b) =>
    b.addEventListener("click", () => {
      btns.forEach((x) => {
        const on = x === b;
        x.classList.toggle("bg-accent", on);
        x.classList.toggle("text-bg", on);
        x.classList.toggle("text-neutral-400", !on);
        x.setAttribute("aria-selected", String(on));
      });
      panels.forEach((p) => {
        const show = p.dataset.panel === b.dataset.view;
        p.hidden = !show;
        if (show) p.querySelectorAll(".reveal").forEach((r) => r.classList.add("is-visible"));
      });
    })
  );
</script>
