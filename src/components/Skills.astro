---
import { iconFor, monogramFor } from "../lib/icons";

interface Props {
  skills: Record<string, string[]>;
}

const { skills } = Astro.props;
const allSkills = Object.values(skills).flat();

const cols = 6;
const rows = Math.ceil(allSkills.length / cols);

const items = allSkills.map((skill, i) => {
  const col = i % cols;
  const row = Math.floor(i / cols);

  const cellW = 100 / cols;
  const cellH = 100 / rows;
  const jitterX = (Math.random() - 0.5) * cellW * 0.55;
  const jitterY = (Math.random() - 0.5) * cellH * 0.55;

  const left = (col + 0.5) * cellW + jitterX;
  const top = (row + 0.5) * cellH + jitterY;

  const fx = (6 + Math.random() * 10).toFixed(1);
  const fy = (6 + Math.random() * 10).toFixed(1);
  const fr = (3 + Math.random() * 6).toFixed(1);
  const duration = (4 + Math.random() * 4).toFixed(1);
  const delay = (Math.random() * 4).toFixed(1);

  return {
    skill,
    icon: iconFor(skill),
    monogram: monogramFor(skill),
    style: `left:${left}%; top:${top}%; --fx:${fx}px; --fy:${fy}px; --fr:${fr}deg; --fdur:${duration}s; --fdelay:${delay}s;`,
  };
});
---

<section id="skills" class="px-6 md:px-16 max-w-5xl mx-auto py-24">
  <p class="font-mono text-accent text-sm mb-2">$ ls -la /tech_stack</p>
  <h2 class="reveal text-2xl md:text-3xl font-bold text-white mb-4" data-scramble>Tech Stack</h2>

  <div class="reveal relative h-[380px] sm:h-[440px] md:h-[500px] rounded-lg border border-border bg-surface/40 overflow-hidden">
    {items.map((item) => (
      <div
        class="float-icon group absolute -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-1.5"
        style={item.style}
      >
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg border border-border bg-bg/80 backdrop-blur-sm flex items-center justify-center transition-all duration-300 group-hover:border-accent group-hover:shadow-[0_0_20px_-4px_var(--color-accent)] group-hover:scale-110">
          {item.icon ? (
            <img src={item.icon} alt={item.skill} class="w-6 h-6 sm:w-7 sm:h-7 object-contain" loading="lazy" />
          ) : (
            <span class="font-mono text-xs font-bold text-accent">{item.monogram}</span>
          )}
        </div>
        <span class="pointer-events-none text-[10px] sm:text-xs font-mono text-neutral-500 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          {item.skill}
        </span>
      </div>
    ))}
  </div>
</section>
