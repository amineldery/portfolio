---
import { ui } from "../lib/ui-icons";

interface Props {
  email: string;
  linkedin: string;
  github: string;
  projects: { name: string; link?: string }[];
}

const { email, linkedin, github, projects } = Astro.props;

const commands = [
  { group: "Navigate", label: "About", hint: "#about", action: "goto", value: "#about" },
  { group: "Navigate", label: "Experience", hint: "#experience", action: "goto", value: "#experience" },
  { group: "Navigate", label: "Projects", hint: "#projects", action: "goto", value: "#projects" },
  { group: "Navigate", label: "Tech stack", hint: "#skills", action: "goto", value: "#skills" },
  { group: "Navigate", label: "Contact", hint: "#contact", action: "goto", value: "#contact" },
  { group: "Actions", label: "Copy email address", hint: email, action: "copy", value: email },
  { group: "Actions", label: "Open resume (PDF)", hint: "pdf", action: "open", value: "/Amin_Eldery_Resume.pdf" },
  { group: "Actions", label: "Open GitHub profile", hint: "github.com", action: "open", value: github },
  { group: "Actions", label: "Open LinkedIn", hint: "linkedin.com", action: "open", value: linkedin },
  ...projects.filter((p) => p.link).map((p) => ({ group: "Repositories", label: p.name, hint: "repo", action: "open", value: p.link! })),
  ...["emerald", "cyan", "violet", "amber", "rose"].map((t) => ({ group: "Theme", label: `Accent: ${t}`, hint: "theme", action: "theme", value: t })),
];
---

<!-- command palette -->
<div id="cmdk" class="cmdk-backdrop fixed inset-0 z-[150] hidden items-start justify-center bg-black/60 backdrop-blur-sm px-4 pt-[14vh]" role="dialog" aria-modal="true" aria-label="Command menu">
  <div class="cmdk-panel w-full max-w-lg rounded-xl border border-border bg-surface shadow-2xl shadow-black/70 overflow-hidden">
    <div class="flex items-center gap-3 px-4 border-b border-border">
      <span class="font-mono text-accent">&gt;</span>
      <input id="cmdk-input" type="text" placeholder="Type a command or search…" autocomplete="off" spellcheck="false" class="flex-1 h-14 bg-transparent outline-none focus-visible:outline-none text-neutral-100 placeholder:text-neutral-500 font-mono text-sm" />
      <span class="kbd">Esc</span>
    </div>
    <ul id="cmdk-list" class="max-h-[50vh] overflow-y-auto p-2" role="listbox">
      {commands.map((c) => (
        <li class="cmdk-item flex items-center justify-between gap-3 px-3 py-2.5 rounded-lg text-sm text-neutral-300 cursor-pointer" role="option" aria-selected="false" data-group={c.group} data-action={c.action} data-value={c.value} data-label={c.label.toLowerCase()}>
          <span class="flex items-center gap-3 min-w-0">
            <span class="font-mono text-[10px] uppercase tracking-wider text-neutral-500 w-20 shrink-0">{c.group}</span>
            <span class="truncate">{c.label}</span>
          </span>
          <span class="cmdk-arrow opacity-0 w-4 h-4 shrink-0" set:html={ui.arrowRight} />
        </li>
      ))}
      <li id="cmdk-empty" class="hidden px-3 py-6 text-center font-mono text-xs text-neutral-500">command not found</li>
    </ul>
    <div class="flex items-center gap-4 px-4 py-2.5 border-t border-border font-mono text-[11px] text-neutral-500">
      <span><span class="kbd">↑</span> <span class="kbd">↓</span> move</span>
      <span><span class="kbd">Enter</span> run</span>
    </div>
  </div>
</div>

<!-- toast -->
<div id="toast" class="toast fixed bottom-6 left-1/2 z-[160] inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-accent/50 bg-surface text-sm text-neutral-100 shadow-[0_10px_40px_-10px_var(--color-accent)]" role="status" aria-live="polite">
  <span class="w-4 h-4 text-accent" set:html={ui.check} />
  <span id="toast-text"></span>
</div>

<!-- back to top -->
<button id="to-top" type="button" class="to-top fixed bottom-6 right-6 z-40 grid place-items-center w-12 h-12 rounded-full bg-surface border border-border text-neutral-300 hover:text-accent transition-colors" aria-label="Back to top">
  <svg class="absolute inset-0 -rotate-90" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="22" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="138.2" stroke-dashoffset="138.2" id="to-top-ring" stroke-linecap="round" />
  </svg>
  <span class="w-4 h-4" set:html={ui.arrowUp} />
</button>

<script>
  // ---------- toast + copy ----------
  const toast = document.getElementById("toast")!;
  const toastText = document.getElementById("toast-text")!;
  let toastTimer = 0;
  function showToast(msg: string) {
    toastText.textContent = msg;
    toast.classList.add("is-shown");
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("is-shown"), 2200);
  }
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      showToast("Email copied to clipboard");
    } catch {
      window.location.href = `mailto:${text}`;
    }
  }
  document.querySelectorAll<HTMLElement>("[data-copy]").forEach((el) =>
    el.addEventListener("click", () => copy(el.dataset.copy!))
  );

  // ---------- command palette ----------
  const root = document.getElementById("cmdk")!;
  const input = document.getElementById("cmdk-input") as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLLIElement>(".cmdk-item")];
  const empty = document.getElementById("cmdk-empty")!;
  let visible: HTMLLIElement[] = items;
  let active = 0;

  function select(i: number) {
    active = (i + visible.length) % visible.length;
    visible.forEach((el, j) => el.setAttribute("aria-selected", String(j === active)));
    visible[active]?.scrollIntoView({ block: "nearest" });
  }

  function filter() {
    const q = input.value.trim().toLowerCase();
    visible = items.filter((el) => {
      const hit = !q || el.dataset.label!.includes(q) || el.dataset.group!.toLowerCase().includes(q);
      el.classList.toggle("hidden", !hit);
      return hit;
    });
    empty.classList.toggle("hidden", visible.length > 0);
    if (visible.length) select(0);
  }

  function open() {
    root.classList.remove("hidden");
    root.classList.add("flex");
    requestAnimationFrame(() => root.classList.add("is-open"));
    input.value = "";
    filter();
    input.focus();
  }

  function close() {
    root.classList.remove("is-open");
    setTimeout(() => { root.classList.add("hidden"); root.classList.remove("flex"); }, 180);
  }

  function run(el: HTMLLIElement) {
    const { action, value } = el.dataset as { action: string; value: string };
    close();
    if (action === "goto") document.querySelector(value)?.scrollIntoView({ behavior: "smooth" });
    else if (action === "open") window.open(value, "_blank", "noopener");
    else if (action === "copy") copy(value);
    else if (action === "theme") { (window as any).setAccent(value); showToast(`Accent set to ${value}`); }
  }

  input.addEventListener("input", filter);
  items.forEach((el) => {
    el.addEventListener("click", () => run(el));
    el.addEventListener("mousemove", () => select(visible.indexOf(el)));
  });
  root.addEventListener("click", (e) => { if (e.target === root) close(); });

  document.addEventListener("keydown", (e) => {
    const isOpen = !root.classList.contains("hidden");
    if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      isOpen ? close() : open();
      return;
    }
    if (!isOpen && e.key === "/" && !(e.target instanceof HTMLInputElement)) {
      e.preventDefault();
      open();
      return;
    }
    if (!isOpen) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowDown") { e.preventDefault(); select(active + 1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); select(active - 1); }
    else if (e.key === "Enter" && visible[active]) { e.preventDefault(); run(visible[active]); }
  });
  window.addEventListener("cmdk:open", open);

  // ---------- back to top ----------
  const toTop = document.getElementById("to-top")!;
  const ring = document.getElementById("to-top-ring")!;
  const onScroll = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? window.scrollY / max : 0;
    toTop.classList.toggle("is-shown", window.scrollY > window.innerHeight * 0.8);
    ring.setAttribute("stroke-dashoffset", String(138.2 * (1 - p)));
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
  toTop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
</script>
