---
import { ui } from "../lib/ui-icons";

interface Props {
  about: string[];
  facts: { icon: keyof typeof ui; label: string; value: string }[];
}

const { about, facts } = Astro.props;
---

<section id="about" class="px-6 md:px-16 max-w-5xl mx-auto py-20">
  <p class="font-mono text-accent text-sm mb-2">01 · $ cat about.md</p>
  <h2 class="reveal text-3xl md:text-4xl font-bold text-white mb-10" data-scramble>About Me</h2>

  <div class="grid md:grid-cols-5 gap-8 items-start">
    <div class="md:col-span-3 space-y-5 text-neutral-300 leading-relaxed text-[1.05rem]">
      {about.map((p, i) => <p class="reveal" style={`--delay:${i * 120}ms`}>{p}</p>)}
    </div>

    <div class="reveal md:col-span-2 rounded-xl border border-border bg-surface/80 overflow-hidden shadow-2xl shadow-black/40" style="--delay:200ms">
      <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border bg-bg/60">
        <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></span>
        <span class="ml-3 font-mono text-[11px] text-neutral-500">quick_facts.sh</span>
      </div>
      <ul class="p-5 space-y-4">
        {facts.map((f) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 grid place-items-center w-8 h-8 shrink-0 rounded-md bg-[var(--accent-soft)] text-accent">
              <span class="w-4 h-4" set:html={ui[f.icon]} />
            </span>
            <span>
              <span class="block font-mono text-[11px] text-neutral-500 uppercase tracking-wider">{f.label}</span>
              <span class="block text-sm text-neutral-200">{f.value}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
