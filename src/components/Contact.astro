---
import { ui } from "../lib/ui-icons";

interface Props {
  contact: { phone: string; email: string; linkedin: string; github: string };
}

const { contact } = Astro.props;
---

<section id="contact" class="px-6 md:px-16 max-w-5xl mx-auto py-20">
  <p class="font-mono text-accent text-sm mb-2">05 · $ ping amin</p>
  <div class="reveal glow-border relative overflow-hidden rounded-2xl border border-border bg-surface/80 px-6 py-14 md:px-14 text-center">
    <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[30rem] h-[30rem] rounded-full bg-accent opacity-[0.08] blur-3xl"></div>
    <h2 class="relative text-3xl md:text-5xl font-bold tracking-tight">
      <span class="gradient-text">Let's build something.</span>
    </h2>
    <p class="relative mt-4 max-w-xl mx-auto text-neutral-400">
      I'm looking for co-op and internship roles in embedded systems, FPGA and hardware design, and DevOps.
      The fastest way to reach me is email.
    </p>

    <div class="relative mt-8 flex flex-wrap justify-center gap-3">
      <button type="button" class="btn btn-primary magnetic" data-copy={contact.email}>
        <span set:html={ui.copy} /> Copy email
      </button>
      <a href={`mailto:${contact.email}`} class="btn magnetic"><span set:html={ui.mail} /> Send email</a>
      <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="btn magnetic"><span set:html={ui.linkedin} /> LinkedIn</a>
      <a href={contact.github} target="_blank" rel="noopener noreferrer" class="btn magnetic"><span set:html={ui.github} /> GitHub</a>
    </div>

    <p class="relative mt-8 font-mono text-xs text-neutral-500">
      {contact.email} <span class="mx-2 text-neutral-700">|</span>
      <a href={`tel:${contact.phone.replace(/[^+\d]/g, "")}`} class="hover:text-accent transition-colors">{contact.phone}</a>
    </p>
  </div>
</section>
