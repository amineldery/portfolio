---
import CircuitBackground from "./CircuitBackground.astro";

interface Props {
  name: string;
  title: string;
  contact: { phone: string; email: string; linkedin: string };
}

const { name, title, contact } = Astro.props;
---

<header class="relative overflow-hidden min-h-[90vh] flex flex-col justify-center px-6 md:px-16 max-w-5xl mx-auto">
  <CircuitBackground class="z-0" />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-bg z-[1]"></div>

  <div class="relative z-10">
    <div class="photo-flip w-28 h-28 mb-6">
      <div class="photo-flip-inner">
        <img
          src="/profile.jpg"
          alt={name}
          width="112"
          height="112"
          class="photo-face photo-front w-28 h-28 rounded-full object-cover border-2 border-border shadow-[0_0_30px_-6px_var(--color-accent)]"
        />
        <img
          src="/flip-photo.jpg"
          alt=""
          width="112"
          height="112"
          class="photo-face photo-back w-28 h-28 rounded-full object-cover border-2 border-border shadow-[0_0_30px_-6px_var(--color-accent)]"
        />
      </div>
    </div>
    <p class="font-mono text-accent text-sm mb-4">$ whoami</p>
    <h1 class="glitch-name text-4xl md:text-6xl font-bold text-white tracking-tight" data-text={name}>{name}</h1>
    <p class="mt-3 text-lg md:text-2xl text-neutral-400 font-mono min-h-[2em]">
      <span id="typewriter"></span><span class="typewriter-cursor" aria-hidden="true">▌</span>
    </p>
    <script define:vars={{ title }}>
      const el = document.getElementById("typewriter");
      if (el) {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          el.textContent = title;
        } else {
          let i = 0;
          const type = () => {
            el.textContent = title.slice(0, i);
            i++;
            if (i <= title.length) setTimeout(type, 35);
          };
          type();
        }
      }
    </script>

    <div class="mt-8 flex flex-wrap gap-4 font-mono text-sm">
      <a href={`mailto:${contact.email}`} class="px-4 py-2 rounded-md border border-border hover:border-accent hover:text-accent hover:shadow-[0_0_20px_-6px_var(--color-accent)] transition-all">
        {contact.email}
      </a>
      <a href={`tel:${contact.phone.replace(/[^+\d]/g, "")}`} class="px-4 py-2 rounded-md border border-border hover:border-accent hover:text-accent hover:shadow-[0_0_20px_-6px_var(--color-accent)] transition-all">
        {contact.phone}
      </a>
      <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-md border border-border hover:border-accent hover:text-accent hover:shadow-[0_0_20px_-6px_var(--color-accent)] transition-all">
        LinkedIn
      </a>
      <a href="/Amin_Eldery_Resume.pdf" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-md border border-accent text-accent hover:bg-accent hover:text-bg hover:shadow-[0_0_20px_-6px_var(--color-accent)] transition-all">
        Resume ↓
      </a>
    </div>

    <a href="#experience" class="mt-16 inline-block font-mono text-xs text-neutral-500 hover:text-accent transition-colors animate-bounce">
      ↓ keep scrolling
    </a>
  </div>
</header>
